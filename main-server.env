# main-server.env — machine-specific knobs for install0-disks.sh / install1.sh / install2.sh
# Sourced by all three. Edit before running. Values below are for server.ljlee37.com
# (ASUS desktop, Intel i5-6500, 32 GiB RAM).
#
# Find disk ids with:  ls -l /dev/disk/by-id/ | grep -v part
# ALWAYS identify disks by id/serial here, never by /dev/sdX (enumeration is not stable).

# --- disks (by-id, WITHOUT the /dev/disk/by-id/ prefix and WITHOUT -partN) ---
# HDD 2 TB  -> pv-slow  (LVM origin: the actual root data lives here)
HDD_ID="ata-ST2000VN004-2E4164_Z52AC71C"
# SSD 128 GB -> ESP (/boot) + swap + pv-fast (LVM cache volume)
SSD_ID="ata-SanDisk_Z400s_2.5_7MM_128GB_162905405855"

# NAS btrfs pool (2x 8 TB, serials WSD3SPAG + WSD4J87P). Mounted at /srv, NEVER
# repartitioned by these scripts. Referenced by UUID only.
SRV_POOL_UUID="5fe2b4ac-7dd0-4ea4-bbc0-373d54e80cca"

# --- sizes ---
SWAP_GIB=32          # >= RAM so hibernate works (RAM is 32 GiB)
CACHE_GIB=80         # LVM cache volume on the SSD; leaves ~6 GiB SSD headroom
CACHE_CHUNK=128k     # 64k (lvm default) * 80 GiB > lvm2's 1e6 max-chunks cap ->
                     # lvconvert refuses. 128k -> ~655k chunks. Reflect in Ansible.
CACHE_MODE=writethrough   # SSD loss must never = root loss on a server

# --- btrfs root ---
BTRFS_LABEL=archroot
BTRFS_SUBVOLS="@ @home @snapshots @var_log"
MNT_OPTS="noatime,compress=zstd"

# --- system identity ---
HOSTNAME_FQDN="server.ljlee37.com"
TIMEZONE="Asia/Seoul"
LANG_DEFAULT="en_US.UTF-8"
USERNAME="ljlee"

# locale.gen entries to enable (exact glibc SUPPORTED spelling; note bare "eo").
LOCALES="en_GB.UTF-8 UTF-8|en_US.UTF-8 UTF-8|eo UTF-8|ja_JP.UTF-8 UTF-8|ko_KR.EUC-KR EUC-KR|ko_KR.UTF-8 UTF-8"
