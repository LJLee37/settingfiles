# 예비 컨트롤 노드(LJUSB): 컨트롤 카드(LJTF)가 죽거나 A 키링을 잃었을 때 이어받는 USB 메모리.
# SanDisk Dual Drive 32GB(USB-A/C 겸용, 0781:55ab)이고 토큰 B 와 같은 키링에 달려 있습니다(2026-10-21).
# 카드와 같은 설치이고 다른 것은 디스크, 이름, 토큰, Steam 을 뺀 프로필뿐입니다. 비밀값은 두지 않습니다.
#
# 이 USB 는 TF 카드보다 느리지 않습니다(2026-10-21 직접 I/O 실측: 순차 읽기 147 대 77 MiB/s,
# 4KiB 동기 쓰기 572 대 49 IOPS - 카드 쪽은 LUKS 와 btrfs 를 거친 숫자). 그래도 오래 꺼 두는 기기라
# 한 달에 한 번쯤 켜서 pacman -Syu 와 git pull, scripts/host-vars.sh check 를 하세요. 몇 달 묵히면
# archlinux-keyring 이 낡아 첫 업데이트가 서명 오류로 멈출 수 있습니다.

# 이 크기(바이트)가 아닌 디스크는 지우지 않습니다. lsblk -bdno SIZE <디스크> 로 확인.
DISK_BYTES=30765219840

HOST_NAME=LJUSB
USERNAME=ljlee
TIMEZONE=Asia/Seoul
LANG_DEFAULT=en_US.UTF-8
LOCALES="en_US.UTF-8 UTF-8|en_GB.UTF-8 UTF-8|ko_KR.UTF-8 UTF-8|ja_JP.UTF-8 UTF-8|eo UTF-8"

# 카드(ljtf)와 달라야 합니다. 카드로 부팅한 채 이 USB 에 설치하므로, 같으면 설치 중에 여는 LUKS 이름
# (ljtf-root)과 파티션 이름이 겹칩니다.
PART_PREFIX=ljusb
ESP_MIB=1024

PORTABLE=yes
LUKS=yes
# 카드의 vault(마스터 SSH 키와 GPG 마스터 키)를 이미지에서 그대로 씁니다(사용자 결정 2026-10-21).
# 비트 그대로라 LUKS UUID 가 카드의 vault 와 같아지므로, 쓴 뒤에 이 USB 쪽 UUID 만 바꿉니다 - 둘 다 꽂혀
# 있으면 /dev/disk/by-uuid 가 어느 쪽을 가리킬지 모릅니다. 안의 내용과 키 슬롯, 토큰은 그대로입니다.
VAULT=yes

MNT_OPTS="noatime,compress=zstd"

# 이 USB 와 같은 키링에 달린 토큰 B.
CONTROL_FIDO_KEY=ljlee_sk_b

# 카드의 프로필에서 steam 만 뺐습니다(게임은 32GB 에 담지 않음). nvidia 는 남깁니다 - 어느 컴퓨터에서나
# 켜지게 하는 것이 이 기기의 목적입니다. 카드에 깔린 패키지 전체가 압축 전 약 9.8GiB 라 들어갑니다.
PROFILES="portable nvidia outside rescue snapshots gnome apps print"
