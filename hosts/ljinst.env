# 임시 설치 USB(LJINST): 게이밍 데스크탑(i5-14400F, RTX 2080)에 Arch 를 Windows 와 듀얼 부팅으로 깔 때 그
# 데스크탑에서 켜는 USB 메모리입니다. 그 안의 Claude Code 가 ~/docs 의 문서대로 설치합니다(2026-11-17).
# SanDisk Ultra USB 3.0 14.3GB(옛 ljtf-card-backup, 그다음 Windows 11 설치 USB WIN11_26H2)입니다.
#
# 사람 개입을 줄이려고 이 USB 에만 sudo NOPASSWD 를 둡니다(사용자 결정 2026-11-17). 이 저장소의 설치 스크립트는
# NOPASSWD 를 만들지 않고, ~/handoffs/arch-usb/build.sh 가 이 USB 에만 얹습니다. 다른 기기에 옮기지 않습니다.
# 비밀값은 두지 않습니다.

# 이 크기(바이트)가 아닌 디스크는 지우지 않습니다. lsblk -bdno SIZE <디스크> 로 확인.
DISK_BYTES=15376318464

HOST_NAME=LJINST
USERNAME=ljlee
TIMEZONE=Asia/Seoul
LANG_DEFAULT=en_US.UTF-8
LOCALES="en_US.UTF-8 UTF-8|ko_KR.UTF-8 UTF-8"

# 카드(ljtf), 예비(ljusb), 그리고 데스크탑에 새로 깔 설치본과 겹치지 않는 이름. 데스크탑 설치본의 PART_PREFIX 는
# 이것과 달라야 합니다(이 USB 로 부팅한 채 설치하므로 파티션 이름이 겹치면 엉뚱한 파티션을 찾습니다).
PART_PREFIX=ljinst
ESP_MIB=1024

# 만드는 기기(컨트롤 노드)와 켜는 기기(데스크탑)가 다르므로 PORTABLE. 임시 USB 라 LUKS 는 쓰지 않습니다.
PORTABLE=yes
LUKS=no
VAULT=no

MNT_OPTS="noatime,compress=zstd"

# 데스크탑의 RTX 2080 에서 GNOME(한글 입력)으로 켜고, Arch 설치 도구와 오프라인 위키를 씁니다.
# outside: 들어오는 연결을 막는 nftables. NOPASSWD 인 기기라 켜 둡니다.
PROFILES="portable nvidia outside rescue gnome"
