# 새 기기용 견본. 복사해서 hosts/<기기>.env 로 두고 값을 채우세요. 항목의 뜻은 hosts/ljtf.env 참고.

# 지울 디스크의 정확한 크기(바이트). 비워 두면 크기 검사를 건너뛰고 확인 질문만 합니다.
DISK_BYTES=

HOST_NAME=TODO-hostname
USERNAME=ljlee
TIMEZONE=Asia/Seoul
LANG_DEFAULT=en_US.UTF-8
LOCALES="en_US.UTF-8 UTF-8|en_GB.UTF-8 UTF-8|ko_KR.UTF-8 UTF-8|ja_JP.UTF-8 UTF-8|eo UTF-8"

PART_PREFIX=todo
ESP_MIB=1024

PORTABLE=no
LUKS=no
VAULT=no

MNT_OPTS="noatime,compress=zstd"

PROFILES="gnome apps"

# 컨트롤 노드로 쓸 때만. install-control-node.sh 가 서명과 로그인에 쓰는 FIDO2 키(비우면 ljlee_sk_a).
CONTROL_FIDO_KEY=
