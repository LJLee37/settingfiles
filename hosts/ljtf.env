# 컨트롤 카드(LJTF): server-automation 컨트롤 노드이자, 어느 컴퓨터에 꽂아도 내 환경으로 켜지는 SD 카드.
# install0-disks.sh, install1.sh, install2.sh 가 읽습니다. 비밀값은 두지 않습니다.

# 이 크기(바이트)가 아닌 디스크는 지우지 않습니다. 다른 컴퓨터(main-server 등)에 꽂고 설치할 때
# 엉뚱한 디스크를 고르는 것을 막는 장치입니다. lsblk -bdno SIZE <디스크> 로 확인.
DISK_BYTES=255869321216

HOST_NAME=LJTF
USERNAME=ljlee
TIMEZONE=Asia/Seoul
LANG_DEFAULT=en_US.UTF-8
LOCALES="en_US.UTF-8 UTF-8|en_GB.UTF-8 UTF-8|ko_KR.UTF-8 UTF-8|ja_JP.UTF-8 UTF-8|eo UTF-8"

# 파티션 이름(GPT partlabel)과 파일시스템 라벨의 앞머리. 다른 기기의 디스크와 이름이 겹치지 않게 합니다.
PART_PREFIX=ljtf
ESP_MIB=1024

# yes: 어느 컴퓨터에서나 켜지게(initramfs 에 모든 저장장치, 키보드 드라이버와 fallback 이미지,
# GRUB 메뉴 대기, 스왑 대신 zram, 저널 크기 제한). 최대 절전은 쓰지 않습니다.
PORTABLE=yes
# yes: 루트를 LUKS2 로 암호화. 부팅 때 비밀번호, 또는 luks-fido2.sh 로 등록한 FIDO2 토큰으로 엽니다.
LUKS=yes
# yes: 예전 카드의 vault(LUKS, 마스터 SSH 키와 GPG 마스터 키)를 이미지에서 그대로 되살립니다.
# 이미지 경로는 install0-disks.sh 의 세 번째 인자로 줍니다.
VAULT=yes

# btrfs 서브볼륨: @ / , @home /home , @snapshots /.snapshots , @var_log /var/log , @pkg /var/cache/pacman/pkg
MNT_OPTS="noatime,compress=zstd"

# install-control-node.sh 가 서명과 로그인에 쓰는 FIDO2 키. 이 카드와 같은 키링에 달린 토큰 A 입니다.
CONTROL_FIDO_KEY=ljlee_sk_a

# 첫 부팅 뒤 install-profile.sh 로 깔 프로필(설치 안내에 씁니다).
PROFILES="portable nvidia outside rescue snapshots gnome steam apps print"
